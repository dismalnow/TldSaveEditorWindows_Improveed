<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TldSave.Core\TldSave.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Shown in the exe's file properties -->
    <AssemblyTitle>TLD Survival Save Editor Improved</AssemblyTitle>
    <Product>TLD Survival Save Editor Improved</Product>
    <Description>Improved fork of YohanWD's Survival save editor, based on FINDarkside/TLD-Save-Editor-3.</Description>
    <Version>1.3.0-preview.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
